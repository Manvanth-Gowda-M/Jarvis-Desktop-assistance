# ============================================================
#  Jarvis 2.0 — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ============================================================

# --- OpenRouter API (required) ---
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# --- Free model selection (must end with :free or be openrouter/free) ---
# OPENROUTER_MODEL=openrouter/free

# --- Assistant identity ---
JARVIS_NAME=Jarvis

# --- Voice settings (Windows SAPI) ---
# VOICE_RATE=1           # SpVoice Rate: -10 (slow) to 10 (fast), default 1
# VOICE_VOLUME=100       # SpVoice Volume: 0-100
# LISTEN_TIMEOUT=5.0     # Seconds to wait for speech
# PHRASE_TIME_LIMIT=7.0  # Max seconds per spoken phrase
# MAX_SPOKEN_CHARS=280   # Max chars spoken aloud (rest shown in terminal)

# --- Wake word ("Hey Jarvis") ---
# WAKE_WORD_THRESHOLD=0.35   # Score threshold; 2 of latest 3 frames must meet/exceed it
# WAKE_WORD_COOLDOWN=2.0     # Seconds to suppress repeat activations
# WAKE_WORD_WINDOW_SIZE=3    # Frames in the detection window
# WAKE_WORD_MIN_HITS=2       # Required threshold hits within the window
# WAKE_WORD_DEVICE_INDEX=5   # Optional input device index (default: auto-resolve)

# --- API and agent limits ---
# API_TIMEOUT=30.0       # HTTP request timeout
# MAX_TOOL_STEPS=6       # Max tool-call iterations per query

# --- Email provider configuration (Gmail + Outlook Graph) ---
# Gmail credentials file downloaded from Google Cloud Console:
# Default: %LOCALAPPDATA%\Jarvis\oauth\google_credentials.json
# GMAIL_CREDENTIALS_FILE=C:\Users\YourName\AppData\Local\Jarvis\oauth\google_credentials.json

# Outlook Application (client) ID from Microsoft Azure Portal:
# JARVIS_OUTLOOK_CLIENT_ID=your-azure-application-client-id-guid
# JARVIS_OUTLOOK_AUTHORITY=https://login.microsoftonline.com/common
# EMAIL_DEFAULT_PROVIDER=auto

# --- Approved file roots (comma-separated paths) ---
# FILE_APPROVED_ROOTS=C:\Users\YourName\Desktop,C:\Users\YourName\Documents

