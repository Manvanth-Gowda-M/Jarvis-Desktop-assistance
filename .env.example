# ============================================================
#  Jarvis 3.0 â€” Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ============================================================

# --- Free AI providers (set at least ONE; more = better failover) ---
# Groq (fastest, also powers Whisper speech recognition): https://console.groq.com/keys
GROQ_API_KEY=
# NVIDIA NIM (large free model catalog): https://build.nvidia.com -> "Get API Key" (starts with nvapi-)
NVIDIA_API_KEY=
# OpenRouter (only :free models are ever used): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Failover order. Providers without a key are skipped.
# LLM_PROVIDER_ORDER=groq,nvidia,openrouter

# Model lists (comma-separated, tried in order). Free catalogs change often;
# update these if a provider retires a model.
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# NVIDIA_MODELS=nvidia/nemotron-3.5-super-vl-120b-a12b,nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3-ultra-550b-a55b,mistralai/mistral-large-4-1t-a52b
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_EXTRA_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free

# Vision models used by "what's on my screen"
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free,openrouter/free

# smart = send only relevant tools per request (saves free-tier tokens); all = send every tool
# TOOL_SELECTION=smart
# LLM_TEMPERATURE=0.6
# LLM_MAX_TOKENS=1200
# RATE_LIMIT_COOLDOWN=45

# --- Personality ---
JARVIS_NAME=Jarvis
# USER_NAME=Tony
# USER_TITLE=sir
# DEFAULT_LOCATION=Hyderabad

# --- Voice ---
# TTS_ENGINE=edge                 # edge (free neural voice, needs internet) or sapi (offline Windows voice)
# EDGE_TTS_VOICE=en-GB-RyanNeural # British male. Others: en-US-GuyNeural, en-GB-ThomasNeural, en-IN-PrabhatNeural
# EDGE_TTS_RATE=+8%
# EDGE_TTS_PITCH=-2Hz
# STT_ENGINE=auto                 # auto (Groq Whisper if GROQ_API_KEY set, else Google), groq, google
# STT_LANGUAGE=en
# VOICE_RATE=2                    # SAPI fallback rate (-10..10)
# VOICE_VOLUME=100
# LISTEN_TIMEOUT=8.0
# PHRASE_TIME_LIMIT=25.0
# MAX_SPOKEN_CHARS=240

# --- Conversation mode (keep listening for a follow-up after each answer) ---
# FOLLOW_UP_ENABLED=true
# FOLLOW_UP_TIMEOUT=5.0
# FOLLOW_UP_MAX_TURNS=6

# --- Desktop mode ---
# GLOBAL_HOTKEY=ctrl+alt+j        # push-to-talk from anywhere
# DESKTOP_GREETING=true

# --- Wake word ("Hey Jarvis") ---
# WAKE_WORD_THRESHOLD=0.25
# WAKE_WORD_COOLDOWN=2.0
# WAKE_WORD_WINDOW_SIZE=3
# WAKE_WORD_MIN_HITS=2
# WAKE_WORD_DEVICE_INDEX=5
# MICROPHONE_DEVICE_INDEX=

# --- API and agent limits ---
# API_TIMEOUT=30.0
# MAX_TOOL_STEPS=6

# --- Email provider configuration (Gmail + Outlook Graph, draft-only) ---
# GMAIL_CREDENTIALS_FILE=C:\Users\YourName\AppData\Local\Jarvis\oauth\google_credentials.json
# JARVIS_OUTLOOK_CLIENT_ID=your-azure-application-client-id-guid
# JARVIS_OUTLOOK_AUTHORITY=https://login.microsoftonline.com/common
# EMAIL_DEFAULT_PROVIDER=auto

# --- Approved file roots (comma-separated paths) ---
# FILE_APPROVED_ROOTS=C:\Users\YourName\Desktop,C:\Users\YourName\Documents
